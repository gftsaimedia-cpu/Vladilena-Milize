# Sao chép thành .env (hoặc đặt biến môi trường trên hosting). Chỉ file .env.example này được commit; .env thì không.
PORT=3000

# Cơ sở dữ liệu là PostgreSQL. App cần DATABASE_URL; test dùng URL điều khiển riêng PG_TEST_URL.
#   DATABASE_URL  máy chủ PostgreSQL thật, dạng postgres://người-dùng:mật-khẩu@máy-chủ:5432/tên-db (môi trường thật phải dùng cách này;
#                 docker compose của dự án dựng sẵn dịch vụ PostgreSQL và tự đặt biến này).
# Không còn hỗ trợ DB_PATH hoặc database trong tiến trình. Tạo database PostgreSQL riêng cho dev rồi đặt DATABASE_URL.
# DATABASE_URL=postgres://luong:mat-khau@localhost:5432/luong_dev
# PG_TEST_URL=postgres://luong_test:mat-khau@localhost:5432/luong_test_control

# Mật khẩu admin, chỉ dùng ở lần khởi động đầu tiên khi DB còn chưa có tài khoản nào.
# Không có mật khẩu mặc định. Để trống: với NODE_ENV=production (Dockerfile đặt sẵn) app báo lỗi và thoát;
# ngoài production app sinh mật khẩu ngẫu nhiên và KHÔNG in ra log (nên không đăng nhập được: đặt biến này rồi tạo lại DB trống).
# MÔI TRƯỜNG THẬT: bắt buộc đặt mật khẩu mạnh, riêng, ít nhất 12 ký tự, cùng với SESSION_SECRET và COOKIE_SECURE=1.
ADMIN_PASSWORD=

# Khoá ký phiên đăng nhập (chuỗi ngẫu nhiên dài). Nếu bỏ trống, app tự sinh và lưu trong DB.
# Môi trường thật nên đặt cố định để khoá không phụ thuộc vào file DB.
SESSION_SECRET=

# Số ngày giữ đăng nhập
SESSION_DAYS=14

# Chạy thử trên máy qua http://localhost: để 0 (cookie Secure sẽ không được gửi qua http, đăng nhập sẽ không giữ được).
# Môi trường thật sau HTTPS (Nginx/Caddy có SSL, Render, Railway, Cloudflare Tunnel): đặt 1.
COOKIE_SECURE=0

# Địa chỉ client dùng cho giới hạn đăng nhập sai và ghi địa chỉ chấm công.
# Để trống khi truy cập thẳng vào app (không qua proxy): app dùng địa chỉ kết nối thật.
# Là SỐ reverse proxy đứng trước app, số nguyên 1-10, phải đúng bằng số proxy thật (thường là 1: Nginx, Caddy,
# Cloudflare Tunnel). App lấy mục thứ n tính từ bên PHẢI của header X-Forwarded-For (do proxy của mình thêm vào).
# Giá trị như true, 0, hoặc ngoài 1-10 bị bỏ qua âm thầm (coi như chưa đặt).
# Đã đặt thì cổng app KHÔNG được truy cập thẳng, chỉ qua proxy (nghe 127.0.0.1 hoặc tường lửa; Docker: -p 127.0.0.1:3000:3000).
# Nếu không, client tự gửi X-Forwarded-For giả và lách giới hạn đăng nhập.
# Đứng sau proxy mà để trống: mọi client dùng chung địa chỉ của proxy, 5 lần đăng nhập sai với một tên đăng nhập
# sẽ khoá tên đó với tất cả mọi người. Không có proxy: để trống.
TRUST_PROXY=

# Sao lưu bằng scripts/ops/pg-backup.ts (npm run pg:backup, pg:verify, pg:drill, pg:restore). Script KHÔNG đọc file .env: đặt các biến
# này trong môi trường của lệnh chạy hoặc của cron/systemd. Nguồn là DATABASE_URL; thư mục đích là --dir, nếu không có thì BACKUP_DIR,
# nếu không có nữa thì ./backups. Thư mục đích không được nằm trong web/dist (thư mục được phục vụ ra ngoài).
# BACKUP_DIR=./backups
# BACKUP_KEEP=30
# DRILL_PG_CONTROL_URL must point to a dedicated PostgreSQL control database (luong_drill_control) with CREATEDB permission.
# DRILL_PG_CONTROL_URL=postgres://user:password@host:5432/luong_drill_control
# Snapshot-based demo tools also require a separate control database with CREATEDB permission; never use the app DATABASE_URL here.
# DEMO_PG_CONTROL_URL=postgres://user:password@host:5432/luong_demo_control
# Sandbox creates and owns temporary databases through this separate control URL.
# SANDBOX_PG_CONTROL_URL=postgres://user:password@host:5432/luong_sandbox_control
# Scenario generation, verification and server copies use this dedicated control URL.
# SCENARIO_PG_CONTROL_URL=postgres://user:password@host:5432/luong_scenario_control
# Root sample seed is deliberately guarded; set this only for a dedicated PostgreSQL seed target.
# SEED_ALLOW_REAL_DB=1

# Khoá HMAC của nhật ký kiểm toán (chuỗi ngẫu nhiên dài, ví dụ 32 byte hex). Bỏ trống: nhật ký dùng băm SHA-256 thường, đủ để thấy sửa
# lẻ nhưng người có quyền ghi DB viết lại được cả chuỗi. Có khoá: băm HMAC, không viết lại được nếu không có khoá.
# MÔI TRƯỜNG THẬT: đặt NGAY từ lần chạy đầu và KHÔNG BAO GIỜ ĐỔI hay xoá về sau (dòng đã ký bằng khoá cũ sẽ báo hỏng khi kiểm;
# chưa có mã nhận dạng khoá để xoay). Lưu một bản khoá ở nơi RIÊNG với bản sao lưu DB (két mật khẩu của công ty, không để chung ổ).
# Mất khoá = không kiểm được nội dung nhật ký cũ (vẫn kiểm được việc nối chuỗi); lộ khoá = người có DB viết lại được nhật ký.
# AUDIT_KEY=

# Công tắc bật chế độ áp dụng tham số (params_mode = active) ở môi trường thật (NODE_ENV=production hoặc COOKIE_SECURE=1).
# Mặc định KHÔNG đặt: lần Lưu đầu tiên trên màn Cài đặt bị từ chối 409 PARAMS_DEFAULTS_ONLY. Chỉ đặt =1 sau khi chủ dự án duyệt
# bằng văn bản, theo deploy/RUNBOOK-THAM-SO.md; xong việc bật thì xoá biến này và khởi động lại (nếu để nguyên, sau một lần lùi về
# defaults-only, lần Lưu kế tiếp sẽ âm thầm bật lại). Ngoài môi trường thật (máy dev, sandbox, test) không cần.
# PARAMS_ALLOW_ACTIVATE=1

# Cờ triển khai (môi trường thật = NODE_ENV=production hoặc COOKIE_SECURE=1; ngoài đó các cờ này tự mở). MẶC ĐỊNH KHÔNG ĐẶT = TẮT.
# SCHEDULE_ALLOW_EDIT=1  cho Lưu lịch làm việc theo chức vụ (type.<chức vụ>.dows).
# SHIFT_ALLOW_EDIT=1     cho sửa giờ vào, ra của sáu ca có sẵn (shift.preset.<mã>.in, out).
# Chỉ đặt sau khi chủ dự án đồng ý và đã kiểm thử không lệch; vẫn cần PARAMS_ALLOW_ACTIVATE ở trên khi params_mode chưa active.
# Tắt lại: xoá dòng và khởi động lại. Chi tiết: deploy/CHECKLIST.md mục 17.
