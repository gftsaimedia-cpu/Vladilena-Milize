# Sao chép thành deploy/secrets/luong.env (thư mục secrets/ đã được .gitignore bỏ qua; KHÔNG commit, không dán vào chat).
# Sinh chuỗi ngẫu nhiên:  openssl rand -hex 32   (hoặc: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")

# Mật khẩu của người dùng PostgreSQL "luong" (dịch vụ db trong docker-compose.yml). Dùng chuỗi ngẫu nhiên dài, chỉ chữ và số để khỏi phải mã hoá trong URL.
POSTGRES_PASSWORD=

# Mật khẩu tài khoản "admin", chỉ dùng ở lần khởi động đầu khi DB còn trống. Bắt buộc, ít nhất 12 ký tự.
ADMIN_PASSWORD=

# Khoá ký phiên đăng nhập. Đặt cố định để khoá không phụ thuộc file DB.
SESSION_SECRET=

# Khoá chuỗi băm nhật ký thay đổi (HMAC). KHÔNG đổi sau khi đã dùng: nhật ký cũ sẽ không kiểm lại được.
AUDIT_KEY=
