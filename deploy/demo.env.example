# Sao chép thành deploy/.env (file này docker compose đọc để điền biến trong docker-compose.yml; .env đã được .gitignore bỏ qua).
# Bí mật của app (mật khẩu Admin, khoá phiên) nằm ở deploy/secrets/luong.env, xem luong.env.example.

# --- Chế độ 1: demo qua IP / HTTP thường, không tên miền ---
# Mở cổng ra ngoài; cookie phiên KHÔNG được đặt Secure (trình duyệt không gửi cookie Secure qua HTTP, đăng nhập sẽ không giữ được).
BIND_ADDR=0.0.0.0
APP_PORT=3000
COOKIE_SECURE=0
TRUST_PROXY=0
# DB riêng cho demo: dùng một database PostgreSQL khác (đặt POSTGRES_DB=luong_demo trong secrets/luong.env). Dữ liệu mẫu: xem specs/DEPLOY.md.
# POSTGRES_DB=luong_demo

# --- Chế độ 2: HTTPS bằng Caddy (docker compose --profile https up -d) ---
# Bỏ ghi chú khối dưới và vô hiệu hoá khối Chế độ 1: cổng 3000 của app chỉ cho 127.0.0.1, Caddy giữ cổng 80 và 443.
# SITE_ADDRESS=demo.ten-mien-cua-ban.com
# BIND_ADDR=127.0.0.1
# COOKIE_SECURE=1
# TRUST_PROXY=1
# POSTGRES_DB=luong
