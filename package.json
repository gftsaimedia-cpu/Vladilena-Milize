{
  "name": "luong-nhan-su",
  "version": "1.0.0",
  "description": "Web app chấm công và tự tính lương cho thực tập sinh, chuyên trách viên và nhân viên",
  "private": true,
  "main": "src/server.ts",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning --import tsx src/server.ts",
    "sandbox": "node scripts/dev/ts.cjs scripts/dev/sandbox-bootstrap.ts",
    "test": "node --import tsx --test \"test/v2/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "typecheck:web": "npm --prefix web exec -- vue-tsc --noEmit -p web"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "express": "^4.22.3",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "prettier": "3.9.10",
    "typescript": "^7.0.2"
  }
}
