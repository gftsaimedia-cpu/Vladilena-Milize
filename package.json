{
  "name": "luong-nhan-su",
  "version": "1.0.0",
  "description": "Web app chấm công và tự tính lương cho thực tập sinh, chuyên trách viên và nhân viên",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server.js",
    "sandbox": "node --no-warnings=ExperimentalWarning scripts/dev/sandbox-server.cjs",
    "seed": "node --no-warnings=ExperimentalWarning scripts/seed.js",
    "seed:demo": "node --no-warnings=ExperimentalWarning scripts/db/seed-demo.js",
    "backup": "node --no-warnings=ExperimentalWarning scripts/ops/backup-db.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"test/**/*.test.js\"",
    "test:unit": "node --no-warnings=ExperimentalWarning --test \"test/unit/**/*.test.js\"",
    "test:api": "node --no-warnings=ExperimentalWarning --test \"test/api/**/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "params:extract": "node --no-warnings=ExperimentalWarning scripts/params/extract-defaults.js",
    "params:lock": "node --no-warnings=ExperimentalWarning scripts/params/lock.js",
    "params:check": "node --no-warnings=ExperimentalWarning scripts/params/check.js",
    "params:doc": "node --no-warnings=ExperimentalWarning scripts/params/doc.js",
    "typecheck": "tsc --noEmit -p .",
    "spec:gen": "node --no-warnings=ExperimentalWarning scripts/docs/gen-spec.js",
    "spec:check": "node --no-warnings=ExperimentalWarning scripts/docs/gen-spec.js --check",
    "db:types": "node scripts/docs/gen-db-types.js",
    "pg:backup": "node --no-warnings=ExperimentalWarning scripts/ops/pg-backup.js backup",
    "pg:verify": "node --no-warnings=ExperimentalWarning scripts/ops/pg-backup.js verify",
    "pg:drill": "node --no-warnings=ExperimentalWarning scripts/ops/pg-backup.js drill",
    "pg:restore": "node --no-warnings=ExperimentalWarning scripts/ops/pg-backup.js restore"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "express": "^4.22.3",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "prettier": "3.9.10",
    "typescript": "^7.0.2"
  }
}
